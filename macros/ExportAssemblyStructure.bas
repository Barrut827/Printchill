Attribute VB_Name = "PrintchillAssemblyStructure"
Option Explicit

' SolidWorks Design Premium 2026 SP0 / VBA 64-bit.
' Read-only active configuration. Does not resolve lightweight components,
' switch configurations, rebuild, save CAD, or change suppression.
Private asmRows As Collection
Private asmWarnings As Collection
Private asmStep As String
Private asmCount As Long

Public Sub main()
    Dim app As SldWorks.SldWorks
    Dim model As SldWorks.ModelDoc2
    Dim config As SldWorks.Configuration
    Dim root As SldWorks.Component2
    Dim fso As Object, stream As Object, doc As SldWorks.ModelDoc2
    Dim source As String, target As String, tempPath As String
    Dim options As Long, configName As String, displayName As String
    Dim errors As Long, warnings As Long, owned As Boolean
    Dim sizeBefore As Variant, timeBefore As Date
    Dim output As String, message As String, i As Long
    On Error GoTo Failed
    Set app = Application.SldWorks
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set asmRows = New Collection
    Set asmWarnings = New Collection
    If Split(app.RevisionNumber, ".")(0) <> "34" Then Err.Raise vbObjectError + 1, , "SolidWorks 2026 is required."
    ' This isolated test owns all documents it opens, including child documents.
    ' Never close a user's pre-existing document.
    Set doc = app.GetFirstDocument
    If Not doc Is Nothing Then Err.Raise vbObjectError + 2, , "Close all SolidWorks documents first. This isolated macro will not change or close existing sessions."
    asmStep = "Select assembly"
    source = app.GetOpenFileName("Printchill - select a closed assembly", "", "SolidWorks assembly (*.sldasm)|*.sldasm|", options, configName, displayName)
    If Len(source) = 0 Then Exit Sub
    If Not fso.FileExists(source) Or LCase$(fso.GetExtensionName(source)) <> "sldasm" Then Err.Raise vbObjectError + 3, , "Select an existing SLDASM."
    target = Trim$(InputBox("New JSON output path (must not already exist):", "Printchill assembly export", source & ".assembly.json"))
    If Len(target) = 0 Then Exit Sub
    If fso.FileExists(target) Or fso.FolderExists(target) Then Err.Raise vbObjectError + 4, , "Output already exists."
    If LCase$(fso.GetExtensionName(target)) <> "json" Or Not fso.FolderExists(fso.GetParentFolderName(target)) Then Err.Raise vbObjectError + 5, , "Select a JSON path in an existing folder."
    tempPath = target & ".partial"
    If fso.FileExists(tempPath) Then Err.Raise vbObjectError + 6, , "Temporary output already exists."
    sizeBefore = fso.GetFile(source).Size
    timeBefore = fso.GetFile(source).DateLastModified
    asmStep = "Open assembly read-only"
    owned = True
    Set model = app.OpenDoc6(source, swDocASSEMBLY, swOpenDocOptions_ReadOnly Or swOpenDocOptions_Silent, "", errors, warnings)
    If model Is Nothing Or errors <> 0 Then Err.Raise vbObjectError + 7, , "Open failed. Errors=" & errors & ", warnings=" & warnings
    If model.IsOpenedReadOnly() = False Then
        If model.SetReadOnlyState(True) = False Then Err.Raise vbObjectError + 8, , "Read-only mode could not be set."
        If model.IsOpenedReadOnly() = False Then Err.Raise vbObjectError + 9, , "Read-only mode was not confirmed."
    End If
    If warnings <> 0 Then asmWarnings.Add "OpenDoc6 warnings=" & CStr(warnings)
    asmStep = "Read active configuration hierarchy"
    Set config = model.ConfigurationManager.ActiveConfiguration
    configName = config.Name
    Set root = config.GetRootComponent3(False)
    If root Is Nothing Then Err.Raise vbObjectError + 10, , "Active configuration root is unavailable; no complete tree exported."
    asmCount = 0
    AsmChildren root, 0
    asmWarnings.Add "Only the currently saved active configuration was inspected. Lightweight/suppressed subassemblies may not expose children."
    asmWarnings.Add "No source hash is generated by this macro. Filename matching is not byte-level revision verification."
    output = "{""schema"":""printchill.assembly.v1"",""source"":{""file"":" & AsmJson(fso.GetFileName(source)) & "},""configuration"":" & AsmJson(configName) & _
        ",""scope"":""Active configuration; no resolve/rebuild/configuration switch. Partial hierarchy possible."",""components"":["
    For i = 1 To asmRows.Count
        If i > 1 Then output = output & ","
        output = output & CStr(asmRows(i))
    Next i
    output = output & "],""warnings"":["
    For i = 1 To asmWarnings.Count
        If i > 1 Then output = output & ","
        output = output & AsmJson(CStr(asmWarnings(i)))
    Next i
    output = output & "]}"
    asmStep = "Close owned assembly and dependency documents without saving"
    AsmCloseOwned app
    owned = False
    If fso.GetFile(source).Size <> sizeBefore Or fso.GetFile(source).DateLastModified <> timeBefore Then Err.Raise vbObjectError + 11, , "Source size or timestamp changed; export cancelled."
    asmStep = "Write new UTF-8 JSON"
    Set stream = CreateObject("ADODB.Stream")
    stream.Type = 2
    stream.Charset = "utf-8"
    stream.Open
    stream.WriteText output
    stream.SaveToFile tempPath, 1
    stream.Close
    fso.MoveFile tempPath, target
    MsgBox "Assembly manifest exported: " & target & vbCrLf & "Component records: " & asmCount & vbCrLf & "Import this JSON in Printchill > Import > SolidWorks assembly manifest.", vbInformation, "Printchill"
    Exit Sub
Failed:
    message = "Export stopped at: " & asmStep & vbCrLf & CStr(Err.Number) & ": " & Err.Description
    On Error Resume Next
    If owned Then AsmCloseOwned app
    If Not stream Is Nothing Then stream.Close
    If Len(tempPath) > 0 Then
        If fso.FileExists(tempPath) Then fso.DeleteFile tempPath
    End If
    MsgBox message & vbCrLf & "No CAD document was saved.", vbExclamation, "Printchill"
End Sub

Private Sub AsmChildren(ByVal parent As SldWorks.Component2, ByVal depth As Long)
    Dim children As Variant, item As Variant
    Dim child As SldWorks.Component2
    Dim childName As String, path As String, config As String, state As String
    Dim suppression As Long
    On Error GoTo Partial
    If depth > 30 Then
        asmWarnings.Add "Depth limit reached; hierarchy is partial."
        Exit Sub
    End If
    children = parent.GetChildren
    If IsEmpty(children) Then Exit Sub
    For Each item In children
        Set child = item
        childName = "Unknown component"
        path = ""
        config = ""
        state = "Unknown"
        On Error Resume Next
        childName = child.Name2
        path = child.GetPathName
        config = child.ReferencedConfiguration
        suppression = child.GetSuppression
        state = "Suppression code " & CStr(suppression)
        If suppression = 0 Then state = "Suppressed; descendants not assumed complete"
        If suppression = 1 Then state = "Lightweight; descendants may be unavailable"
        If suppression = 2 Then state = "Resolved"
        If Err.Number <> 0 Then
            state = "Partially readable component"
            asmWarnings.Add "Some component fields could not be read: " & childName
            Err.Clear
        End If
        On Error GoTo Partial
        asmCount = asmCount + 1
        If asmCount > 10000 Then Err.Raise vbObjectError + 20, , "Component limit reached."
        asmRows.Add "{""name"":" & AsmJson(childName) & ",""path"":" & AsmJson(path) & ",""configuration"":" & AsmJson(config) & ",""state"":" & AsmJson(state) & ",""depth"":" & CStr(depth) & "}"
        AsmChildren child, depth + 1
    Next item
    Exit Sub
Partial:
    asmWarnings.Add "Child enumeration incomplete at depth " & CStr(depth) & ": " & Err.Description
    Err.Clear
End Sub

Private Sub AsmCloseOwned(ByVal app As SldWorks.SldWorks)
    Dim doc As SldWorks.ModelDoc2, remaining As SldWorks.ModelDoc2, title As String
    Set doc = app.GetFirstDocument
    Do While Not doc Is Nothing
        title = doc.GetTitle
        app.CloseDoc title
        Set remaining = app.GetFirstDocument
        If Not remaining Is Nothing Then
            If remaining.GetTitle = title Then Err.Raise vbObjectError + 31, , "An owned document could not be closed: " & title
        End If
        Set doc = remaining
    Loop
End Sub

Private Function AsmJson(ByVal value As String) As String
    Dim i As Long, code As Long, result As String, character As String
    result = Chr$(34)
    For i = 1 To Len(value)
        character = Mid$(value, i, 1)
        code = AscW(character)
        Select Case code
            Case 34: result = result & "\" & Chr$(34)
            Case 92: result = result & "\\"
            Case 0 To 31: result = result & "\u" & Right$("0000" & Hex$(code), 4)
            Case Else: result = result & character
        End Select
    Next i
    AsmJson = result & Chr$(34)
End Function
