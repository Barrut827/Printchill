{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PRC: Installeer ontwikkelomgeving",
      "type": "process",
      "command": "npm.cmd",
      "args": ["ci"],
      "options": {"cwd": "${workspaceFolder}/MVP"},
      "problemMatcher": []
    },
    {
      "label": "PRC: Test functionaliteit",
      "type": "process",
      "command": "node.exe",
      "args": ["--test", "store.test.mjs", "server.test.mjs", "release.test.mjs", "collections.test.mjs", "report-data.test.mjs", "related-files.test.mjs"],
      "options": {"cwd": "${workspaceFolder}/MVP"},
      "problemMatcher": []
    },
    {
      "label": "PRC: Test browserflow",
      "type": "process",
      "command": "node.exe",
      "args": ["--test", "--test-concurrency=1", "ui.test.mjs", "reports.test.mjs", "import.test.mjs"],
      "options": {"cwd": "${workspaceFolder}/MVP"},
      "problemMatcher": []
    },
    {
      "label": "PRC: Stop backend",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "RemoteSigned", "-File", "${workspaceFolder}/scripts/stop-prc.ps1"],
      "problemMatcher": []
    },
    {
      "label": "PRC: Start vanuit broncode",
      "dependsOn": "PRC: Stop backend",
      "type": "process",
      "command": "node.exe",
      "args": ["server.mjs"],
      "options": { "cwd": "${workspaceFolder}/MVP", "env": { "PRC_PORT": "47831" } },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "PRC: Bouw en installeer Windows-pilot",
      "dependsOn": "PRC: Stop backend",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "RemoteSigned", "-File", "${workspaceFolder}/MVP/build.ps1", "-Install"],
      "problemMatcher": []
    }
  ]
}
